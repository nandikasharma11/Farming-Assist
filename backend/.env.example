PROJECT_NAME=Farming Assist
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security
SECRET_KEY=generate-a-secure-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL Async or SQLite Async)
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/krishi_khata
# For SQLite:
DATABASE_URL=sqlite+aiosqlite:///krishi_khata.db

# Multimodal Vision AI
GEMINI_API_KEY=your_gemini_api_key_here

# Mandi & Weather APIs
DATAGOV_API_KEY=your_datagov_api_key_here
MANDI_CACHE_TTL_HOURS=12
